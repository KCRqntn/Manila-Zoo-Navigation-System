# Copy to deploy/.env.production on the server and fill in the values.
# Use the same values as the project's .env on your laptop. Never commit the filled-in file.

# Address visitors open. With no domain of your own, use the server's IP with dashes + .sslip.io,
# e.g. for IP 203.0.113.5:  SITE_DOMAIN=203-0-113-5.sslip.io  (Caddy still gets a real HTTPS certificate)
SITE_DOMAIN=

# Supabase Postgres connection string (Supabase → Project Settings → Database → Connection string)
DATABASE_URL=

# Supabase project URL and anon key (public; they are built into the website)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase service role key (secret; only the API uses it)
SUPABASE_SERVICE_ROLE_KEY=
