# Serves the website over HTTPS (Caddy gets and renews the certificate automatically) and
# forwards /api to the API container. SITE_DOMAIN comes from deploy/.env.production.
{$SITE_DOMAIN} {
	encode gzip

	handle /api/* {
		reverse_proxy api:5000
	}

	handle {
		root * /srv/site
		# The service worker and the page itself must always be fresh so updates reach visitors
		@fresh path /sw.js /index.html /
		header @fresh Cache-Control "no-cache"
		# Built scripts and styles get a new name whenever they change, so browsers can keep them a year
		# instead of re-checking each one on every visit
		@hashed path_regexp hashed ^/assets/[^/]+-[A-Za-z0-9_-]{6,}\.(js|css|woff2?|png|jpg|svg|webp)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		# Single-page app: unknown paths (/map, /animals/3…) load index.html
		try_files {path} /index.html
		file_server
	}
}
