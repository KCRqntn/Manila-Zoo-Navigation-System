# The ZooBot intent model (fine-tuned bert-base-multilingual-cased) behind FastAPI on port 8000.
# Build context: ai-training/ (see deploy/docker-compose.yml). Needs ~1.5 GB of memory at run time.
FROM python:3.12-slim
WORKDIR /app
# CPU-only PyTorch: the server has no GPU, and this wheel is far smaller than the default one
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir transformers fastapi "uvicorn[standard]"
COPY predict_api.py ./
COPY models ./models
EXPOSE 8000
CMD ["uvicorn", "predict_api:app", "--host", "0.0.0.0", "--port", "8000"]
